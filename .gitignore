.venv/
venv/
env/
ENV/

# Local secrets and private configuration
.env
.env.*
!.env.example
secrets/
local-secrets/

# Private / personal source data
private-data/
local-data/
raw-personal-chats/

# Temporary files and logs
*.log
*.tmp
*.temp

# Operating-system noise
.DS_Store
Thumbs.db
Desktop.ini